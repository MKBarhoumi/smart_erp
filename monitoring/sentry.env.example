# Sentry Configuration for Laravel
# Install: composer require sentry/sentry-laravel

SENTRY_DSN=https://example@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Performance Monitoring
SENTRY_ENABLE_PERFORMANCE_MONITORING=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Session Replay
SENTRY_ENABLE_SESSION_REPLAY=true
SENTRY_SESSION_REPLAY_SAMPLE_RATE=0.1

# Error Reporting
SENTRY_ERROR_SAMPLE_RATE=1.0

# User Feedback
SENTRY_ENABLE_USER_FEEDBACK=true

# Before Send Hook
SENTRY_BEFORE_SEND_CALLBACK=true

# Tags and Context
SENTRY_DEFAULT_TAGS=environment,version,release

# Integrations
SENTRY_ENABLE_LIVELINESS_PROBE=true
SENTRY_ENABLE_READINESS_PROBE=true